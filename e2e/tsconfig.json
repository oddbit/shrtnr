{
  // The e2e suite runs in Node under Playwright, not in the Worker, so it
  // typechecks separately from the root config: `yarn tsc --noEmit -p e2e`.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@playwright/test"],
    "jsx": "preserve",
    "jsxImportSource": null
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
