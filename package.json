{
  "name": "shrtnr",
  "version": "0.38.0",
  "description": "A free, open-source, self-hosted URL shortener built on Cloudflare Workers + D1",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash scripts/resolve-bindings.sh && wrangler deploy",
    "wrangler-login": "wrangler login",
    "db:create": "wrangler d1 create shrtnr-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "secret:put": "wrangler secret put",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "emit-spec": "tsx scripts/emit-spec.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.0",
    "@vitest/runner": "^4.1.10",
    "@vitest/snapshot": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@hono/zod-openapi": "^1.5.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "^0.19.0",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  }
}
