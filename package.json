{
  "name": "shrtnr",
  "version": "0.43.0",
  "description": "A free, open-source, self-hosted URL shortener built on Cloudflare Workers + D1",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "migrations:bundle": "tsx scripts/generate-migrations.ts",
    "predev": "yarn migrations:bundle",
    "dev": "wrangler dev",
    "types": "wrangler types --env-file wrangler.types.env",
    "deploy": "wrangler deploy",
    "wrangler-login": "wrangler login",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "secret:put": "wrangler secret put",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "perf": "PERF_THROTTLE=1 E2E_PINNED_ONLY=1 playwright test e2e/perf.spec.ts",
    "emit-spec": "tsx scripts/emit-spec.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "jsqr": "1.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
